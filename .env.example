# FinAlly environment. Copy to .env (the start scripts do this for you).
# Every variable is optional; the app runs with this file as-is.

# OpenRouter API key for LLM chat. Without it (and with LLM_MOCK not "true"),
# everything else works and POST /api/chat returns 503 "LLM not configured".
OPENROUTER_API_KEY=

# Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# "true" returns deterministic mock LLM responses (tests, no API key needed).
LLM_MOCK=false

# SQLite file path. Empty = <repo root>/db/finally.db.
# The Docker image sets DB_PATH=/app/db/finally.db; don't override it there.
DB_PATH=

# --- Advanced (rarely needed) ---
# Massive poll interval in seconds (free tier: 15).
# MASSIVE_POLL_SECONDS=15
# Local development only: enables CORS for http://localhost:3000 (next dev).
# DEV_MODE=false
